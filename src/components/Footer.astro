---
import logo from '../assets/logo.svg';

const anoAtual = new Date().getFullYear();
---

<footer class="footer section" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-marca">
        <img
          src={logo.src}
          alt="OCA"
          class="footer-logo"
          width="48"
          height="48"
          loading="lazy"
        />
        <p class="footer-descricao">
          Uma internet brasileira — privada<br/>por padrão, acessível, e sua.
        </p>
      </div>

      <nav class="footer-links" aria-label="Links do rodapé">
        <a href="https://github.com/OCA-Internet-Brasileira" rel="external noopener">
          GitHub
        </a>
        <a href="https://github.com/OCA-Internet-Brasileira/oca-manual" rel="external noopener">
          Manifesto
        </a>
        <a href="https://github.com/OCA-Internet-Brasileira/oca-vitrine/blob/main/LICENSE" rel="external noopener">
          Licença MIT
        </a>
      </nav>
    </div>

    <div class="footer-linha" aria-hidden="true">
      <svg viewBox="0 0 1200 2" preserveAspectRatio="none">
        <line x1="0" y1="1" x2="1200" y2="1" stroke="var(--border-default)" stroke-width="1"/>
      </svg>
    </div>

    <p class="footer-copyright">
      &copy; {anoAtual} OCA Internet Brasileira.
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    border-top: 1px solid var(--border-default);
  }

  .footer-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer-grid {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer-marca {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .footer-logo {
    width: 40px;
    height: 40px;
    opacity: 0.7;
  }

  .footer-descricao {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    line-height: var(--leading-relaxed);
  }

  .footer-links {
    display: flex;
    gap: var(--space-6);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--duration-padrao) var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--highlight-1);
  }

  .footer-linha {
    margin-bottom: var(--space-6);
  }

  .footer-linha svg {
    width: 100%;
    height: 2px;
  }

  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }
</style>
