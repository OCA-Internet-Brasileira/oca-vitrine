---
import MorphCanvas from './MorphCanvas.astro';
import logo from '../assets/logo.svg';
---

<section class="hero section">
  <MorphCanvas />

  <div class="container hero-conteudo">
    <div class="logo-wrapper">
      <img
        src={logo.src}
        alt="OCA"
        class="logo"
        width="160"
        height="160"
      />
    </div>

    <h1 class="tagline">
      Uma internet brasileira<span class="destaque"> —</span><br/>
      privada<span class="destaque">,</span> acessível<span class="destaque">,</span> sua<span class="destaque">.</span>
    </h1>

    <p class="subtitulo">
      Construindo a plataforma que coloca você no controle.
    </p>

    <a href="#novidades" class="cta">
      Receber novidades
      <svg class="cta-seta" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    </a>
  </div>

  <div class="gradiente-base" aria-hidden="true"></div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    text-align: center;
    isolation: isolate;
  }

  .hero-conteudo {
    position: relative;
    z-index: var(--z-above);
  }

  .logo-wrapper {
    margin-bottom: var(--space-12);
  }

  .logo {
    width: clamp(120px, 20vw, 180px);
    height: auto;
    filter: drop-shadow(0 0 40px rgb(99 102 241 / 0.3));
    animation: logo-pulso 4s var(--ease-in-out) infinite;
  }

  @keyframes logo-pulso {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
  }

  .tagline {
    max-width: 800px;
    margin: 0 auto var(--space-6);
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .tagline {
      font-size: var(--text-7xl);
    }
  }

  .destaque {
    color: var(--highlight-1);
  }

  .subtitulo {
    max-width: 480px;
    margin: 0 auto var(--space-12);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    text-wrap: balance;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--text-inverse);
    background: linear-gradient(135deg, var(--highlight-2), var(--highlight-1));
    border-radius: var(--radius-full);
    transition:
      transform var(--duration-padrao) var(--ease-spring),
      box-shadow var(--duration-padrao) var(--ease-out);
    box-shadow: 0 4px 20px rgb(99 102 241 / 0.3);
  }

  .cta:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 30px rgb(99 102 241 / 0.45);
    color: var(--text-inverse);
  }

  .cta-seta {
    width: 16px;
    height: 16px;
    transition: transform var(--duration-padrao) var(--ease-out);
  }

  .cta:hover .cta-seta {
    transform: translateX(4px);
  }

  .gradiente-base {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: linear-gradient(to top, var(--surface-0), transparent);
    z-index: 1;
    pointer-events: none;
  }
</style>
