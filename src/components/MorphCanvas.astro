<canvas
  id="canvas-hero"
  aria-hidden="true"
/>

<script is:inline>
  (function () {
    const canvas = document.getElementById('canvas-hero') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const PALETA = ['#6366f1', '#8b5cf6', '#a855f7', '#06b6d4', '#ec4899', '#f59e0b'];
    const QTD = 60;

    class Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      raio: number;
      cor: string;
      vertices: number;
      angulo: number;
      rotacao: number;

      constructor(w: number, h: number) {
        this.x = Math.random() * w;
        this.y = Math.random() * h;
        this.vx = (Math.random() - 0.5) * 0.6;
        this.vy = (Math.random() - 0.5) * 0.6;
        this.raio = Math.random() * 3 + 1;
        this.cor = PALETA[Math.floor(Math.random() * PALETA.length)];
        this.vertices = Math.random() > 0.5 ? 3 : 4 + Math.floor(Math.random() * 3);
        this.angulo = Math.random() * Math.PI * 2;
        this.rotacao = (Math.random() - 0.5) * 0.01;
      }

      atualiza(w: number, h: number) {
        this.x += this.vx;
        this.y += this.vy;
        this.angulo += this.rotacao;
        if (this.x < -20) this.x = w + 20;
        if (this.x > w + 20) this.x = -20;
        if (this.y < -20) this.y = h + 20;
        if (this.y > h + 20) this.y = -20;
      }

      desenha() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.angulo);
        ctx.globalAlpha = 0.5;
        ctx.fillStyle = this.cor;
        ctx.beginPath();
        for (let i = 0; i < this.vertices; i++) {
          const a = (i / this.vertices) * Math.PI * 2 - Math.PI / 2;
          const px = Math.cos(a) * this.raio * 2.5;
          const py = Math.sin(a) * this.raio * 2.5;
          i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
        }
        ctx.closePath();
        ctx.fill();
        ctx.restore();
      }
    }

    function conecta(ps: Particle[]) {
      for (let i = 0; i < ps.length; i++) {
        for (let j = i + 1; j < ps.length; j++) {
          const dx = ps[i].x - ps[j].x;
          const dy = ps[i].y - ps[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 100) {
            ctx.beginPath();
            ctx.moveTo(ps[i].x, ps[i].y);
            ctx.lineTo(ps[j].x, ps[j].y);
            ctx.strokeStyle = ps[i].cor;
            ctx.globalAlpha = 0.08 * (1 - dist / 100);
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }
    }

    function resize() {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    }

    const particles = Array.from({ length: QTD }, () => new Particle(canvas.offsetWidth, canvas.offsetHeight));

    function anima() {
      resize();
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const p of particles) {
        p.atualiza(canvas.width, canvas.height);
        p.desenha();
      }
      conecta(particles);
      requestAnimationFrame(anima);
    }

    anima();
  })();
</script>

<style>
  #canvas-hero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>
